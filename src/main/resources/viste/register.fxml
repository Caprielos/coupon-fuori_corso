<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="439.0" prefWidth="660.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.univaq.disim.oop.controller.RegisterController">
   <children>
      <CheckBox fx:id="clienteBox" layoutX="88.0" layoutY="68.0" mnemonicParsing="false" onAction="#clienteBoxAction" text="Sono Un Cliente" />
      <CheckBox fx:id="ristoranteBox" layoutX="419.0" layoutY="68.0" mnemonicParsing="false" onAction="#ristoranteBoxAction" text="Sono Un Ristorante" />
      <TextField fx:id="usernameTextField" layoutX="248.0" layoutY="120.0" promptText="Username" />
      <TextField fx:id="emailTextField" layoutX="248.0" layoutY="158.0" promptText="Email" />
      <PasswordField fx:id="passwordField" layoutX="248.0" layoutY="195.0" promptText="Password" />
      <TextField fx:id="nomeClienteTextField" layoutX="32.0" layoutY="120.0" promptText="Nome" />
      <TextField fx:id="cognomeClienteTextField" layoutX="32.0" layoutY="158.0" promptText="Cognome" />
      <TextField fx:id="nomeRistoranteTextField" layoutX="481.0" layoutY="120.0" promptText="Nome" />
      <TextField fx:id="indirizzoRistoranteTextField" layoutX="481.0" layoutY="158.0" promptText="Indirizzo" />
      <TextField fx:id="numeroCivicoRistoranteTextField" layoutX="481.0" layoutY="195.0" promptText="Numero Civico" />
      <Button fx:id="registratiButton" layoutX="297.0" layoutY="285.0" mnemonicParsing="false" onAction="#registratiAction" text="Registrati" />
      <ImageView fitHeight="40.0" fitWidth="39.0" layoutX="297.0" layoutY="371.0" pickOnBounds="true" preserveRatio="true" />
      <ImageView fx:id="backImg" fitHeight="39.0" fitWidth="39.0" layoutX="14.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@immagini/Freccia%20a%20sinistra.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
